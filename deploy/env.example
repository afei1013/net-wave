# net-wave 生产环境配置模板
# 服务器上复制为项目根目录 .env 后编辑：
#   cp deploy/env.example .env && vim .env
# docker compose 启动时自动读取同目录 .env

# 容器端口只绑定回环：公网流量一律走 Nginx 反代（安全必需，勿改为 0.0.0.0）
NW_BIND=127.0.0.1

# 宿主机映射端口（默认 3000；若端口冲突可修改，需同步修改 nginx 配置中的 proxy_pass）
PORT=3000

# 管理中心登录密码
# - 设置后每次启动以此为准
# - 留空则首启随机生成，仅打印一次到日志：docker compose logs net-wave | grep 密码
ADMIN_PASSWORD=
